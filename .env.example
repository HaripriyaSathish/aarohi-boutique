DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret-for-production
ALLOWED_HOSTS=127.0.0.1,localhost
PAYMENT_MODE=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=orders@example.com

AI_MODE=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_MAX_REQUESTS_PER_HOUR=30

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=60

# Real courier integration: SHIPPING_MODE=shiprocket.
# Use a Shiprocket API user, not the main customer-account credentials.
SHIPPING_MODE=demo
SHIPROCKET_TOKEN=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
PARCEL_WEIGHT_KG=0.5
PARCEL_LENGTH_CM=25
PARCEL_BREADTH_CM=20
PARCEL_HEIGHT_CM=5

# demo creates in-app updates and marks email simulated; no external email.
# email uses the configured Django EMAIL_BACKEND.
NOTIFICATION_MODE=demo
DEMO_TRACK_SECONDS=15

# Required only for live reverse-pickup bookings.
RETURN_WAREHOUSE_NAME=
RETURN_WAREHOUSE_ADDRESS=
RETURN_WAREHOUSE_CITY=
RETURN_WAREHOUSE_STATE=
RETURN_WAREHOUSE_PIN=
RETURN_WAREHOUSE_PHONE=
RETURN_WAREHOUSE_EMAIL=

AGENT_ENGINE=langgraph

FASHN_API_KEY=
TRYON_MODEL=tryon-v1.6

# Optional tracing is off; LangGraph does not require a LangSmith account.
LANGSMITH_TRACING=false

# Optional absolute SQLite path; leave unset to use project/db.sqlite3.
# DATABASE_PATH=/var/lib/aarohi/db.sqlite3

# V4: for real multi-step Gemini execution, set AI_MODE=gemini and GEMINI_API_KEY.
# The bundled configuration starts in an explicitly labelled local sandbox.

# Cashfree test mode: PAYMENT_MODE=cashfree
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# Database: local MySQL (DB_ENGINE=mysql + DB_* values) or, on Render, set
# DATABASE_URL=postgresql://... (Neon). DATABASE_URL wins when present.
DB_ENGINE=mysql
DB_NAME=aarohi_boutique
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# DATABASE_URL=
SITE_URL=http://127.0.0.1:8001
# Hosted demo without a courier account (production only):
# ALLOW_DEMO_SHIPPING=true
